# Mojify test channels — see AGENTS.md "Test channels".
# Copy to .env (gitignored) and fill in. Never commit real thread IDs or phone numbers.

MOJIFY_TEST_MESSENGER_URL=https://www.messenger.com/e2ee/t/<thread-id>
MOJIFY_TEST_FACEBOOK_URL=
MOJIFY_TEST_DISCORD_URL=https://discord.com/channels/<server-id>/<channel-id>
MOJIFY_TEST_TELEGRAM_URL=
MOJIFY_TEST_WHATSAPP_URL=https://web.whatsapp.com/send?phone=<country><number>
MOJIFY_TEST_INSTAGRAM_URL=https://www.instagram.com/direct/t/<thread-id>
